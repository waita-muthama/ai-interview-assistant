# Obtain an API key from https://platform.openai.com/api-keys
# This key is private: never put it in frontend JavaScript.
OPENAI_API_KEY=replace_with_your_api_key

# You can change models if these aren't enabled in your account.
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# The launch scripts bind to 127.0.0.1:8765 (local machine only).
